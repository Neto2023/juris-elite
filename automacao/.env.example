# Copie para .env na VPS e preencha. NUNCA versione o .env.
# Gere as senhas com:  openssl rand -hex 24

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=juris
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA
POSTGRES_DB=juris

# --- Evolution API (WhatsApp) ----------------------------------------------
# EVOLUTION_SERVER_URL é como a própria Evolution se enxerga. Como ela fica
# publicada só no loopback, o valor interno da rede Docker é o correto.
EVOLUTION_SERVER_URL=http://juris-evolution:8080
EVOLUTION_API_KEY=TROQUE_ESTA_CHAVE
EVOLUTION_INSTANCE=juriselite

# --- Anthropic --------------------------------------------------------------
# Crie em https://console.anthropic.com -> API Keys. Coloque créditos antes.
ANTHROPIC_API_KEY=sk-ant-...

# --- Operação ---------------------------------------------------------------
# Link de convite do grupo de WhatsApp dos candidatos.
GRUPO_CONVITE_URL=https://chat.whatsapp.com/XXXXXXXX
# URL pública do PDF do Mapa de Pontos (pode ser um link do Drive com acesso aberto).
MAPA_PONTOS_URL=
# Número que recebe os avisos de escalonamento, formato internacional sem símbolos.
EQUIPE_WHATSAPP=5594XXXXXXXXX
# Porta do agente (não mude sem ajustar o compose).
PORT=3001

# Origens que podem chamar POST /api/cadastro, separadas por virgula.
# Sem isto, qualquer site enche a base de leads falsos.
ORIGENS_PERMITIDAS=https://juriselite.com.br,https://www.juriselite.com.br
